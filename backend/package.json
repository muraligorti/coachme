{
  "name": "fitos-nexus-backend",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "echo 'See prisma/BASELINE.md for the one-time baseline process - not a single command, has to be run carefully and reviewed.'",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coach": "vitest run tests/coach.test.js",
    "test:client": "vitest run tests/client.test.js",
    "test:admin": "vitest run tests/admin.test.js",
    "test:perf": "vitest run tests/performance.test.js --testTimeout=60000"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "firebase-admin": "^13.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "resend": "^6.9.3",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "vitest": "^2.1.4"
  }
}
